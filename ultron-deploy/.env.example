AGENT_LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE=https://localhost/agent
OPENROUTER_TITLE=Ultron

# Caching configuration
REDIS_URL=redis://localhost:6379/0
CACHE_VERSION=1

# Boltz-2 biomolecular structure prediction / protein design
# Local NIM deployment (default):
#   BOLTZ2_BASE_URL=http://localhost:8000
#   BOLTZ2_ENDPOINT_TYPE=local
# NVIDIA GPU-hosted API:
#   BOLTZ2_BASE_URL=https://health.api.nvidia.com
#   BOLTZ2_ENDPOINT_TYPE=nvidia_hosted
#   NVIDIA_API_KEY=your_nvcf_api_key
# AWS SageMaker:
#   BOLTZ2_ENDPOINT_TYPE=sagemaker
#   SAGEMAKER_ENDPOINT_NAME=my-boltz2-endpoint
# The bundled boltz2_client package is auto-located by the boltz_2 skill.

# Evo2 genomic foundation model (Arc Institute, via NVIDIA NIM API)
# Get your API key at: https://build.nvidia.com/arc/evo2-40b
# NVIDIA_API_KEY=your_nvidia_api_key
# EVO2_BASE_URL=https://integrate.api.nvidia.com/v1
# EVO2_MODEL=evo2-40b

# Hermes — Telegram Bot (Pantheon Reformation 2026-08)
# Get token from @BotFather on Telegram, then set:
# TELEGRAM_BOT_TOKEN=1234567890:AAH...your_token
# TELEGRAM_CHAT_ID=your_default_chat_or_channel_id
# TELEGRAM_CHANNEL_ID=@your_channel
# Optional allowlist: TELEGRAM_ALLOWED_CHAT_IDS=123,456,789

# ---- Self-update system ----
# Git URL Ultron pulls from when the UPDATE button is clicked.
# For a private repo embed a fine-grained token (contents:read):
#   ULTRON_REPO_URL=https://<token>@github.com/<user>/<repo>.git
ULTRON_REPO_URL=

